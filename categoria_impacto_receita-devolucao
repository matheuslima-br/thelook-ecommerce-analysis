-- Análise: Receita e devoluções por categoria
--
-- Área:
-- Vendas + Atendimento
--
-- Objetivo:
-- Identificar quais categorias apresentam maior índice
-- de devolução e qual o impacto financeiro dessas devoluções.
--
-- Indicadores:
-- - Quantidade de pedidos
-- - Receita total
-- - Quantidade de devoluções
-- - Taxa de devolução
-- - Receita devolvida


SELECT

    -- Categoria do produto
    p.category,

    -- Quantidade total de itens vendidos
    COUNT(oi.id) AS pedidos,

    -- Receita total da categoria
    ROUND(SUM(oi.sale_price), 2) AS receita_total,

    -- Quantidade de itens devolvidos
    COUNTIF(oi.returned_at IS NOT NULL) AS devolvidos,

    -- Percentual de devolução
    ROUND(
        100 * COUNTIF(oi.returned_at IS NOT NULL)
        / COUNT(oi.id),
        2
    ) AS taxa_devolucao_percentual,

    -- Receita perdida devido às devoluções
    ROUND(
        SUM(
            CASE
                WHEN oi.returned_at IS NOT NULL THEN oi.sale_price
                ELSE 0
            END
        ),
        2
    ) AS receita_devolvida

FROM `bigquery-public-data.thelook_ecommerce.order_items` oi

JOIN `bigquery-public-data.thelook_ecommerce.products` p
ON oi.product_id = p.id

GROUP BY
    p.category

ORDER BY
    taxa_devolucao_percentual DESC,
    receita_devolvida DESC;
